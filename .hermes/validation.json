{
  "language_configs": {
    "python": {
      "detect": [
        "*.py",
        "requirements.txt",
        "pyproject.toml"
      ],
      "src": "backend/src/",
      "test": "python -m pytest backend/tests/ -v --cov=backend/src --cov-report=term-missing",
      "lint": "python -m ruff check backend/src/ backend/tests/",
      "lint_fix": "python -m ruff check --fix backend/src/ backend/tests/",
      "format": "python -m ruff format backend/src/ backend/tests/",
      "format_check": "python -m ruff format --check backend/src/ backend/tests/",
      "type_check": "python -m mypy backend/src/ --ignore-missing-imports",
      "security": "python -m pip-audit --desc || true"
    },
    "typescript": {
      "detect": [
        "*.ts",
        "*.tsx",
        "tsconfig.json",
        "next.config.ts"
      ],
      "src": "frontend/src/",
      "test": "npx vitest run",
      "lint": "npx eslint src/",
      "type_check": "npx tsc --noEmit",
      "build": "npm run build"
    }
  }
}
