{
  "language_configs": {
    "python": {
      "detect": [
        "*.py",
        "requirements.txt",
        "pyproject.toml"
      ],
      "lint": "python -m ruff check src/ tests/",
      "lint_fix": "python -m ruff check --fix src/ tests/",
      "format": "python -m ruff format src/ tests/",
      "format_check": "python -m ruff format --check src/ tests/",
      "type_check": "python -m mypy src/ --ignore-missing-imports",
      "test": "python -m pytest tests/ -v --cov=src --cov-report=term-missing",
      "security": "python -m pip_audit --desc || true"
    },
    "javascript": {
      "detect": [
        "*.js",
        "package.json",
        "node_modules/"
      ],
      "lint": "npx eslint src/",
      "lint_fix": "npx eslint --fix src/",
      "type_check": "npx tsc --noEmit",
      "test": "npm test",
      "security": "npm audit"
    },
    "typescript": {
      "detect": [
        "*.ts",
        "tsconfig.json",
        "package.json"
      ],
      "lint": "npx eslint src/",
      "lint_fix": "npx eslint --fix src/",
      "type_check": "npx tsc --noEmit",
      "test": "npm test",
      "security": "npm audit"
    },
    "rust": {
      "detect": [
        "Cargo.toml"
      ],
      "lint": "cargo clippy -- -D warnings",
      "lint_fix": null,
      "type_check": "cargo check",
      "test": "cargo test",
      "security": "cargo audit"
    },
    "go": {
      "detect": [
        "go.mod"
      ],
      "lint": "golangci-lint run",
      "lint_fix": null,
      "type_check": "go vet ./...",
      "test": "go test ./...",
      "security": "govulncheck ./..."
    }
  },
  "fallback": {
    "lint": null,
    "lint_fix": null,
    "type_check": null,
    "test": null
  }
}