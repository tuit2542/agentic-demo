{
  "language_configs": {
    "python": {
      "detect": ["*.py", "requirements.txt", "pyproject.toml"],
      "lint": "python -m ruff check src/ tests/",
      "lint_fix": "python -m ruff check --fix src/ tests/",
      "type_check": "python -m mypy src/ --ignore-missing-imports",
      "test": "python -m pytest tests/ -v"
    },
    "javascript": {
      "detect": ["*.js", "package.json", "node_modules/"],
      "lint": "npx eslint src/",
      "lint_fix": "npx eslint --fix src/",
      "type_check": "npx tsc --noEmit",
      "test": "npm test"
    },
    "typescript": {
      "detect": ["*.ts", "tsconfig.json", "package.json"],
      "lint": "npx eslint src/",
      "lint_fix": "npx eslint --fix src/",
      "type_check": "npx tsc --noEmit",
      "test": "npm test"
    },
    "rust": {
      "detect": ["Cargo.toml"],
      "lint": "cargo clippy -- -D warnings",
      "lint_fix": null,
      "type_check": "cargo check",
      "test": "cargo test"
    },
    "go": {
      "detect": ["go.mod"],
      "lint": "golangci-lint run",
      "lint_fix": null,
      "type_check": "go vet ./...",
      "test": "go test ./..."
    }
  },
  "fallback": {
    "lint": null,
    "lint_fix": null,
    "type_check": null,
    "test": null
  }
}
