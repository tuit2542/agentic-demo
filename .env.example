# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
JWT_SECRET=dev-secret-change-in-prod-must-be-32-chars+
JWT_EXPIRE_MINUTES=60
RATE_LIMIT=100/60

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database
# For in-memory store: leave empty or unset
# DATABASE_URL=
# For SQLite persistence:
# DATABASE_URL=urlshortener.db
# For SQLite in-memory (tests):
# DATABASE_URL=:memory:
# DATABASE_URL=postgresql://user:***@localhost:5432/agentic

# Defaults:
# - DATABASE_URL empty → InMemory UrlStore + InMemoryUserRepo
# - RATE_LIMIT "100/60" → 100 requests per 60 seconds (sliding window)
# - JWT_SECRET must be ≥32 chars in production
